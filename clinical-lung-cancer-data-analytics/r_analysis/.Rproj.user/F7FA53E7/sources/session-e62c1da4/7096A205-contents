# Convert Alive/Dead to 0/1
dataset$vital_status <- ifelse(dataset$vital_status == "Dead", 1, 0)

# Remove missing values
dataset <- na.omit(dataset)

# Fit Kaplan-Meier model
fit <- survfit(
  Surv(overall_survival_months, vital_status) ~ 1,
  data = dataset
)

# Plot
plot(
  fit,
  main = "Kaplan-Meier Survival Curve",
  xlab = "Survival Months",
  ylab = "Survival Probability",
  col = "blue",
  lwd = 2
)
